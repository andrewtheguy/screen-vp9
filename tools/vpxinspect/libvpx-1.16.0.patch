+/* What each read of a VP9 stream cost, by kind, and what its blocks were:
+ * an inspection build of libvpx's decoder for screen-vp9's measurements. */
+#ifndef VPX_DSP_VPXI_H_
+#define VPX_DSP_VPXI_H_
+
+enum {
+  VPXI_HEADER,
+  VPXI_PARTITION,
+  VPXI_SKIP,
+  VPXI_SEGMENT,
+  VPXI_REF,
+  VPXI_TX,
+  VPXI_INTRA_MODE,
+  VPXI_INTER_MODE,
+  VPXI_FILTER,
+  VPXI_MV,
+  VPXI_COEF_INTRA,
+  VPXI_COEF_INTER,
+  VPXI_COEF_INTRA_UV,
+  VPXI_COEF_INTER_UV,
+  VPXI_CATS
+};
+
+extern double vpxi_bits[VPXI_CATS];
+extern int vpxi_cat;
+
+#endif
