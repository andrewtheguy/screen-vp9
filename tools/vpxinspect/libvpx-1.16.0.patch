+    vpxi_frame.header_bytes = (double)vpx_rb_bytes_read(&rb);
+    vpxi_frame.keyframes = cm->frame_type == KEY_FRAME;
+    vpxi_frame.qindex = cm->base_qindex;
+  }
   data += vpx_rb_bytes_read(&rb);
   if (!read_is_valid(data, first_partition_size, data_end))
     vpx_internal_error(&cm->error, VPX_CODEC_CORRUPT_FRAME,
@@ -3063,4 +3181,13 @@ void vp9_decode_frame(VP9Decoder *pbi, const uint8_t *data,
