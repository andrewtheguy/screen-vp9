+/* The blocks of a stream, by luma area. */
+static struct {
+  double inter, intra, skip_inter, skip_intra;
+  double bsize[2][BLOCK_SIZES];
+  double tx[2][TX_SIZES];
+  double mode[INTER_MODES];
+  double ref[MAX_REF_FRAMES], compound;
+  double moved, subpel, half, filter[SWITCHABLE_FILTERS + 1];
+  double frames, bytes, header_bytes, keyframes;
+  double bits[VPXI_CATS];
+  double qindex;
+} vpxi_all, vpxi_frame;
+
+static void vpxi_mv(double area, const MV *mv, int filter) {
+  if (mv->row == 0 && mv->col == 0) return;
+  vpxi_frame.moved += area;
+  if ((mv->row & 7) || (mv->col & 7)) {
+    vpxi_frame.subpel += area;
+    if (!(mv->row & 3) && !(mv->col & 3)) vpxi_frame.half += area;
+    vpxi_frame.filter[filter] += area;
+  }
+}
+
+static void vpxi_block(const MODE_INFO *mi, int x_mis, int y_mis) {
+  const double area = 64.0 * x_mis * y_mis;
+  const int inter = is_inter_block(mi);
+  if (inter) {
+    vpxi_frame.inter += area;
+    if (mi->skip) vpxi_frame.skip_inter += area;
+    vpxi_frame.mode[INTER_OFFSET(mi->mode)] += area;
+    vpxi_frame.ref[mi->ref_frame[0]] += area;
+    if (has_second_ref(mi)) vpxi_frame.compound += area;
+    if (mi->sb_type < BLOCK_8X8) {
+      int i;
+      for (i = 0; i < 4; ++i)
+        vpxi_mv(area / 4, &mi->bmi[i].as_mv[0].as_mv, mi->interp_filter);
+    } else {
+      vpxi_mv(area, &mi->mv[0].as_mv, mi->interp_filter);
+    }
+  } else {
+    vpxi_frame.intra += area;
+    if (mi->skip) vpxi_frame.skip_intra += area;
+  }
+  vpxi_frame.bsize[inter][mi->sb_type] += area;
+  vpxi_frame.tx[inter][mi->tx_size] += area;
+}
+
+static void vpxi_add(double *to, const double *from, size_t n) {
+  size_t i;
+  for (i = 0; i < n; ++i) to[i] += from[i];
+}
+
+static const char *const vpxi_names[VPXI_CATS] = {
+  "header", "partition", "skip", "segment", "ref", "tx",
+  "intra_mode", "inter_mode", "filter", "mv", "coef_intra", "coef_inter",
+  "coef_intra_uv", "coef_inter_uv"
+};
+
+static void vpxi_print(const char *what) {
+  const double area = vpxi_frame.inter + vpxi_frame.intra;
+  int i;
+  fprintf(stderr, "%s bytes %.0f header_bytes %.0f keyframes %.0f q %.1f", what,
+          vpxi_frame.bytes, vpxi_frame.header_bytes, vpxi_frame.keyframes,
+          vpxi_frame.qindex / (vpxi_frame.frames > 0 ? vpxi_frame.frames : 1));
+  for (i = 0; i < VPXI_CATS; ++i)
+    fprintf(stderr, " %s %.0f", vpxi_names[i], vpxi_frame.bits[i] / 8);
+  fprintf(stderr, " | area %.0f intra %.0f skip_intra %.0f inter %.0f skip_inter %.0f",
+          area, vpxi_frame.intra, vpxi_frame.skip_intra, vpxi_frame.inter,
+          vpxi_frame.skip_inter);
+  fprintf(stderr, " nearest %.0f near %.0f zero %.0f new %.0f",
+          vpxi_frame.mode[INTER_OFFSET(NEARESTMV)],
+          vpxi_frame.mode[INTER_OFFSET(NEARMV)],
+          vpxi_frame.mode[INTER_OFFSET(ZEROMV)],
+          vpxi_frame.mode[INTER_OFFSET(NEWMV)]);
+  fprintf(stderr, " last %.0f golden %.0f altref %.0f compound %.0f",
+          vpxi_frame.ref[LAST_FRAME], vpxi_frame.ref[GOLDEN_FRAME],
+          vpxi_frame.ref[ALTREF_FRAME], vpxi_frame.compound);
+  fprintf(stderr, " moved %.0f subpel %.0f half %.0f regular %.0f smooth %.0f sharp %.0f bilinear %.0f",
+          vpxi_frame.moved, vpxi_frame.subpel, vpxi_frame.half,
+          vpxi_frame.filter[EIGHTTAP], vpxi_frame.filter[EIGHTTAP_SMOOTH],
+          vpxi_frame.filter[EIGHTTAP_SHARP], vpxi_frame.filter[BILINEAR]);
+  for (i = 0; i < 2; ++i) {
+    int b;
+    fprintf(stderr, " %s_bsize", i ? "inter" : "intra");
+    for (b = 0; b < BLOCK_SIZES; ++b) fprintf(stderr, " %.0f", vpxi_frame.bsize[i][b]);
+    fprintf(stderr, " %s_tx", i ? "inter" : "intra");
+    for (b = 0; b < TX_SIZES; ++b) fprintf(stderr, " %.0f", vpxi_frame.tx[i][b]);
+  }
+  fprintf(stderr, "\n");
+}
+
+static void vpxi_total(void) {
+  vpxi_frame = vpxi_all;
+  vpxi_print("total");
+}
